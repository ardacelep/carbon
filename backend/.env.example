# ── Veritabanı (Supabase) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI Model (NVIDIA build.nvidia.com) ────────────────────────────────────────
# API anahtarı: build.nvidia.com → sağ üst köşe → "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kullanılacak model ID'leri (opsiyonel — aşağıdaki değerler varsayılandır)
# Önerilen açık kaynak modeller: meta/llama-3.3-70b-instruct, nvidia/nemotron-nano-9b-v2
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_MODEL_SMALL=meta/llama-3.1-8b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── EPİAŞ Şeffaflık Platformu ─────────────────────────────────────────────────
# Kayıt: seffaflik.epias.com.tr
EPTR_USERNAME=your_epias_username
EPTR_PASSWORD=your_epias_password

# ── Çalışma Modu ──────────────────────────────────────────────────────────────
# true → EPİAŞ API'si yerine simüle (mock) veri kullanır.
# EPİAŞ erişimi yokken veya lokal test sırasında true yapın.
MOCK_MODE=false

# ── CORS (Deploy için) ────────────────────────────────────────────────────────
# Frontend'in deploy edildiği URL'leri virgülle ayırarak girin.
# Örn: https://axiom.vercel.app,https://custom-domain.com
ALLOWED_ORIGINS=

# ── Gelişmiş / Opsiyonel ──────────────────────────────────────────────────────
# EPİAŞ API timeout süresi (saniye). Ağır yüklü saatlerde artırılabilir.
API_TIMEOUT=12
